# ══════════════════════════════════════════════════════════════════════════════
# CHURNGUARD — PROJECT-SPECIFIC
# ══════════════════════════════════════════════════════════════════════════════

# Environment secrets — NEVER commit
.env
.env.local
.envrc

# Model artifacts — large binary files stored on HuggingFace Hub instead
# Regenerated by: python scripts/run_training.py
models/staging/
models/artifacts/*.pkl
models/artifacts/reference_distribution.pkl

# Training data splits — large numpy arrays, regenerated by run_feature_engineering.py
# Regenerated by: python scripts/run_feature_engineering.py
data/splits/

# MLflow local tracking — local only, never deployed to cloud
# View with: mlflow ui --port 5000
mlruns/

# Generated log files — auto-created by every pipeline run
logs/

# EDA plots — regenerated by run_eda.py, served from reports repo instead
src/ml/eda/reports/figures/

# Python bytecode cache
__pycache__/
*.py[cod]
*.pyo


