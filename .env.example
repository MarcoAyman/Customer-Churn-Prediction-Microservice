# ══════════════════════════════════════════════════════════════════════════════
# ChurnGuard — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# SETUP:
#   cp .env.example .env
#   Fill in all values marked ← REQUIRED
#   Never commit .env — it is in .gitignore
#
# WHERE TO FIND EACH VALUE:
#   DATABASE_URL      → Supabase dashboard → Project Settings → Database → Connection string
#                       Use the "Transaction pooler" string (port 6543)
#   ADMIN_API_KEY     → choose any strong random string
#                       Must match VITE_ADMIN_KEY in both React apps on Vercel
#   HUGGINGFACE_TOKEN → huggingface.co → Settings → Access Tokens → New token (write access)
#   CORS_ORIGINS      → your Vercel app URLs (comma-separated, no trailing slash)
# ══════════════════════════════════════════════════════════════════════════════


# ── DATABASE ──────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string
# MUST use port 6543 (pgBouncer transaction pooler) — NOT port 5432 (direct)
# Port 6543 is required for psycopg2 connection pooling on Render
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# ← REQUIRED


# ── API SECURITY ──────────────────────────────────────────────────────────────

# Admin API key — protects all /api/v1/admin/* endpoints
# Used as X-Admin-Key header in fetch() calls from the ops dashboard
# Used as ?admin_key= query param for SSE (EventSource cannot send headers)
# Must match VITE_ADMIN_KEY environment variable in both Vercel React apps
ADMIN_API_KEY=change-me-use-a-strong-random-string-in-production
# ← REQUIRED


# ── HUGGINGFACE HUB ───────────────────────────────────────────────────────────

# HuggingFace access token with WRITE permission
# Required for: scripts/run_training.py (pushes model artifacts to HF Hub)
# Required for: API startup (downloads model artifacts from HF Hub)
# Required for: scripts/run_batch_scoring.py (downloads model from HF Hub)
# Get it at: huggingface.co → Settings → Access Tokens → New token → write
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ← REQUIRED


# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
# Add your Vercel app URLs here — no trailing slash
# Development: include localhost ports you use
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-ops-dashboard.vercel.app,https://your-entry-form.vercel.app
# ← REQUIRED (update with your actual Vercel URLs)


# ── ENVIRONMENT ───────────────────────────────────────────────────────────────

# Environment label — used in API startup logs and health check response
# Values: development | staging | production
ENVIRONMENT=development
